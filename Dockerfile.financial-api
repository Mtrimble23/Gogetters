# Financial API Backend Dockerfile for fly.io deployment
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV GEMINI_API_KEY=AIzaSyDLTtbDamrXYLo4Q2I2btd9g8FVVJAAqHc

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libc-dev \
    libffi-dev \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy requirements first (for better caching)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire application
COPY . .

# Copy React build (if exists) and ensure data files are included
COPY stock-dashboard/build ./static
COPY stock-dashboard/public/data ./static/data

# Make startup script executable
RUN chmod +x startup.sh

# Create necessary directories
RUN mkdir -p /app/logs

# Expose the port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the startup script
CMD ["./startup.sh"]